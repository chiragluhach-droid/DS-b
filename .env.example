NODE_ENV=development
PORT=5001

# --- Database ----------------------------------------------------------------
# Note the /daansetu path segment — without it Atlas writes to the "test" database.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/daansetu
# Used by `npm test`, and by `npm run seed` if you point it somewhere local.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/daansetu_test

# --- Sessions ----------------------------------------------------------------
# In production both secrets must be random and at least 32 characters, or the
# API refuses to start. Generate with: openssl rand -base64 48
JWT_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# Leave this unset. The API decides per request: "lax" when the web app and API
# are the same site (daansetu.in / api.daansetu.in), "none" when they are not
# (a vercel.app URL calling a railway.app one, which browsers only allow over
# HTTPS). Set it only to force a specific value.
# COOKIE_SAMESITE=
# COOKIE_DOMAIN=.daansetu.in

# --- Web app -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://daansetu.in,https://www.daansetu.in
# QR codes and tracking links are built from this, so it must be the public URL.
APP_PUBLIC_URL=http://localhost:3000

# --- Payments ----------------------------------------------------------------
# Leave these blank in development to run the built-in MOCK gateway: the full
# create-order → verify → record path executes without real keys.
# In production the API refuses to start without them, unless you explicitly set
# ALLOW_MOCK_PAYMENTS=true for a demo deployment that takes no real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# ALLOW_MOCK_PAYMENTS=false

# --- First admin (npm run bootstrap) ----------------------------------------
# ADMIN_EMAIL=you@daansetu.in
# ADMIN_PASSWORD=
# ADMIN_NAME=
